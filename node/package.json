{
  "name": "@cabaret/node",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "cabaret"
  },
  "scripts": {
    "build": "napi build --platform --manifest-path ../lib/Cargo.toml --features napi -o .",
    "build:release": "napi build --platform --manifest-path ../lib/Cargo.toml --features napi -o . --release"
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:"
  }
}
