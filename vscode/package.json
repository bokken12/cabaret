{
  "name": "cabaret",
  "displayName": "Cabaret",
  "version": "0.0.0",
  "private": true,
  "description": "Diff-based in-editor code review",
  "categories": [
    "Other"
  ],
  "publisher": "cabaret",
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --loader:.node=copy --asset-names=[name] --sourcemap --outfile=out/extension.js",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o cabaret.vsix"
  },
  "dependencies": {
    "@cabaret/node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  },
  "contributes": {
    "commands": [
      {
        "command": "cabaret.home",
        "title": "Cabaret: Home"
      },
      {
        "command": "cabaret.showChange",
        "title": "Cabaret: Show Change"
      },
      {
        "command": "cabaret.diff",
        "title": "Cabaret: Diff"
      },
      {
        "command": "cabaret.refresh",
        "title": "Cabaret: Refresh"
      },
      {
        "command": "cabaret.stepIn",
        "title": "Cabaret: Step In"
      },
      {
        "command": "cabaret.stepOut",
        "title": "Cabaret: Step Out"
      },
      {
        "command": "cabaret.stepUp",
        "title": "Cabaret: Step Up"
      },
      {
        "command": "cabaret.stepDown",
        "title": "Cabaret: Step Down"
      },
      {
        "command": "cabaret.land",
        "title": "Cabaret: Land"
      },
      {
        "command": "cabaret.rebase",
        "title": "Cabaret: Rebase"
      },
      {
        "command": "cabaret.toggleArchived",
        "title": "Cabaret: Toggle Archived"
      }
    ],
    "keybindings": [
      {
        "command": "cabaret.diff",
        "key": "d",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.refresh",
        "key": "r",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "key": "q",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.stepIn",
        "key": "enter",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.stepOut",
        "key": "escape",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && !findWidgetVisible && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.stepUp",
        "key": "shift+6",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.stepDown",
        "key": "shift+4",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.land",
        "key": "shift+1 l",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.rebase",
        "key": "shift+1 r",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      },
      {
        "command": "cabaret.toggleArchived",
        "key": "shift+1 a",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      }
    ]
  },
  "engines": {
    "vscode": "^1.125.0"
  }
}
