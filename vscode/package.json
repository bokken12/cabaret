{
  "name": "cabaret",
  "displayName": "Cabaret",
  "description": "Diff-based in-editor code review",
  "version": "0.0.0",
  "private": true,
  "publisher": "cabaret",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cabaret.home",
        "title": "Cabaret: Home"
      },
      {
        "command": "cabaret.showChanges",
        "title": "Cabaret: Show Changes"
      },
      {
        "command": "cabaret.showChange",
        "title": "Cabaret: Show Change"
      },
      {
        "command": "cabaret.rebase",
        "title": "Cabaret: Rebase"
      }
    ],
    "keybindings": [
      {
        "command": "cabaret.openTarget",
        "key": "enter",
        "when": "editorTextFocus && resourceScheme == cabaret && !editorHasSelection && (!vim.active || vim.mode == 'Normal')"
      }
    ]
  },
  "scripts": {
    "compile": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cabaret/node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "catalog:",
    "typescript": "catalog:"
  }
}
